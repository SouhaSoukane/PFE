{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "values": [
      {
        "expr0": null
      }
    ]
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "commercial_id",
      "type": "nominal",
      "title": "ID du Commercial"
    },
    "y": {
      "aggregate": "sum",
      "field": "chiffre_affaires",
      "type": "quantitative",
      "title": "Chiffre d'Affaires Total"
    }
  },
  "transform": [
    {
      "filter": {
        "field": "commercial_id",
        "equal": "dernier_commercial_id"
      }
    }
  ]
}